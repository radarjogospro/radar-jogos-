import fs from "fs";

// Atualiza jogos.json usando API-Football (api-sports)
const OUT = "jogos.json";
const API_KEY = process.env.API_FOOTBALL_KEY || "";
const API_HOST = "v3.football.api-sports.io";
const BASE = `https://${API_HOST}`;

function tsSeconds(ms){ return Math.floor(ms/1000); }

async function fetchJson(url){
  const res = await fetch(url, {
    headers: {
      "x-apisports-key": API_KEY,
      "x-apisports-host": API_HOST
    }
  });
  if(!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

function mapFixtureToGame(fx){
  const fixture = fx.fixture || {};
  const statusShort = (fixture.status?.short || "").toUpperCase();
  const elapsed = fixture.status?.elapsed || 0;
  
  // REGRA: Se o jogo está LIVE mas passou de 115 min, forçar Finalizado (FT)
  let finalStatus = statusShort;
  if ((statusShort === "1H" || statusShort === "2H" || statusShort === "LIVE" || statusShort === "HT") && elapsed > 115) {
    finalStatus = "FT";
  }

  return {
    id: "fb-" + fixture.id,
    sport: "football",
    league: fx.league?.name || "",
    country: fx.league?.country || "",
    home: fx.teams?.home?.name || "",
    away: fx.teams?.away?.name || "",
    startTs: tsSeconds(Date.parse(fixture.date)),
    status: finalStatus,
    minute: elapsed,
    scoreHome: fx.goals?.home,
    scoreAway: fx.goals?.away,
    odds: { home: null, draw: null, away: null }
  };
}

async function generateReal(){
  const today = new Date().toISOString().split('T')[0];
  const data = await fetchJson(`${BASE}/v3/fixtures?date=${today}&timezone=America/Sao_Paulo`);
  if(!data.response) return [];
  return data.response.map(mapFixtureToGame);
}

// CORREÇÃO DA DATA NO DEMO (Para não aparecer "Domingo")
function footballGame(i) {
  const now = Date.now();
  const r = () => Math.random();
  const randint = (min, max) => Math.floor(Math.random() * (max - min + 1) + min);
  
  // Gera jogos entre 2 horas atrás e 10 horas à frente (tudo HOJE)
  const offsetMs = (i - 20) * (15 * 60 * 1000); 
  const startMs = now + offsetMs;
  const started = startMs < now;

  let status = "NS", minute = null, scoreHome = null, scoreAway = null;
  if (started) {
    const elapsed = Math.floor((now - startMs) / 60000);
    if (elapsed < 110) {
      status = "LIVE"; minute = elapsed;
      scoreHome = randint(0, 3); scoreAway = randint(0, 2);
    } else {
      status = "FT"; minute = 90;
      scoreHome = randint(0, 4); scoreAway = randint(0, 4);
    }
  }
  return {
    id: "demo-" + i,
    sport: "football",
    league: "Liga Demonstrativa", country: "Brasil",
    home: "Time " + i, away: "Rival " + i,
    startTs: tsSeconds(startMs),
    status, minute, scoreHome, scoreAway,
    odds: { home: 1.80, draw: 3.20, away: 2.50 }
  };
}

async function main(){
  let games = [];
  let source = "DEMO";
  try{
    if(!API_KEY) throw new Error("Sem Chave");
    games = await generateReal();
    source = "REAL";
  }catch(err){
    for (let i=1; i<=50; i++) games.push(footballGame(i));
  }
  
  const obj = {
    updatedAt: new Date().toLocaleString("pt-BR", { timeZone: "America/Sao_Paulo" }),
    cacheBust: Date.now().toString(),
    source,
    games
  };
  fs.writeFileSync(OUT, JSON.stringify(obj, null, 2));
  console.log(`Atualizado: ${games.length} jogos (${source})`);
}

main();
